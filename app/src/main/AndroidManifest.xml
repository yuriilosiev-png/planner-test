<?xml version="1.0" encoding="utf-8"?>
<!-- Версия задаётся ТОЛЬКО в app/build.gradle (defaultConfig). Раньше versionCode/
     versionName дублировались здесь и отстали (7/1.6 против 8/1.7) — Gradle их
     переопределяет, но читать манифест было обманчиво. Убраны намеренно. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.planner.app">
    <!-- INTERNET нужен для гибрид-режима: WebView сначала пробует загрузить
         GitHub Pages, при отсутствии сети падает на офлайн-копию из assets. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- POST_NOTIFICATIONS — persistent-уведомление со списком задач (Этап 2).
         Runtime-запрос — в MainActivity. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Этап 2: foreground service для постоянного уведомления.
         FOREGROUND_SERVICE — с Android 9 (API 28).
         FOREGROUND_SERVICE_SPECIAL_USE — обязателен с Android 14 (API 34),
         тип объявлен в <service> ниже. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Перезапуск сервиса после перезагрузки телефона (Этап 2). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Запись в Downloads на Android 9 и ниже (API 24-28).
         На Android 10+ (API 29+) используется MediaStore — разрешение не нужно,
         поэтому ограничиваем maxSdkVersion. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Голосовой ввод (1.7.4): с Android 11 (API 30) приложение не видит чужие
         активити без явного объявления. Без этого блока queryIntentActivities
         вернёт пустой список, hasVoiceInput() скажет «нет» — и микрофоны не
         появятся ни у кого. RECORD_AUDIO не нужен: пишет системный распознаватель. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>
    <!-- <uses-sdk> убран: min/target SDK задаются ТОЛЬКО в app/build.gradle, Gradle
         их всё равно переопределяет при мердже. Строка висела с targetSdkVersion="35"
         и вводила в заблуждение — ровно та же ловушка, что была с versionCode. -->
    <!-- Тема БЕЗ fullscreen: планировщику нужен обычный статусбар (время,
         батарея). Edge-to-edge включается программно в MainActivity. -->
    <!-- enableOnBackInvokedCallback="false" — ОПТ-АУТ ОТ PREDICTIVE BACK.
         С target API 36 Android перестаёт вызывать Activity.onBackPressed() и не
         рассылает KEYCODE_BACK. У нас onBackPressed() переопределён (MainActivity,
         webView.canGoBack() → goBack()), и без этого флага кнопка «назад» в офлайн-
         фолбэке повела бы себя иначе. Флаг возвращает старое поведение целиком.
         ВРЕМЕННО: в 1.8 мигрировать на OnBackInvokedCallback и флаг убрать. -->
    <application
        android:enableOnBackInvokedCallback="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:usesCleartextTraffic="false">
        <!-- launchMode=singleTask: приложение одноэкранное, а с приходом SEND-интента
             из Telegram или Диска стандартный режим создал бы второй экземпляр в чужой
             задаче — два разных WebView на один localStorage. singleTask гарантирует
             один экземпляр, входящий файл приходит в onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Поделиться» файлом копии прямо в Planner: в Telegram, на Диске и в
                 Файлах приложение появится в списке получателей. Это единственный
                 надёжный путь для Telegram — файл там лежит в облаке, а не в папке.
                 text/plain НЕ добавляем: иначе Planner полезет в каждый шаринг текста. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Открытие файла тапом в файловом менеджере -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="application/json" />
                <data android:scheme="file" android:mimeType="application/json" />
            </intent-filter>
        </activity>
        <!-- Этап 2: foreground service постоянного уведомления.
             specialUse — потому что кейс (постоянный read-only список задач)
             не подходит под dataSync/shortService/остальные типы Android 14.
             exported=false — сервис только для внутреннего запуска. -->
        <service
            android:name=".NotificationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent notification listing the user's tasks for the current day" />
        </service>
        <!-- vC 11: будильник шторки. Ресивер будится AlarmManager'ом на ближайшее
             время задачи (или на полночь) и перерисовывает уведомление. Через
             ресивер, а не через startForegroundService, потому что с Android 12
             запуск FGS из фона запрещён, а неточный будильник в исключения не
             входит. Разрешений не требует: setAndAllowWhileIdle, не setExact*.
             exported=false — будим только сами себя. -->
        <receiver
            android:name=".NotifAlarmReceiver"
            android:enabled="true"
            android:exported="false" />
        <!-- 1.7.7: «выполнено» из шторки и виджета. Шлём только сами себе
             через PendingIntent — exported=false. -->
        <receiver
            android:name=".DoneReceiver"
            android:exported="false" />
        <!-- 1.7.7: виджет «Сегодня» на главном экране. label — подпись в списке
             виджетов лаунчера. -->
        <receiver
            android:name=".TodayWidget"
            android:label="@string/app_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>
        <!-- 1.7.7: строки списка виджета. BIND_REMOTEVIEWS — подключиться может
             только система. -->
        <service
            android:name=".TodayWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <!-- FileProvider — обязателен для «Поделиться» файлом на Android 7+.
             Без него система бросает FileUriExposedException.
             authorities ОБЯЗАН совпадать с тем, что строит код:
             getPackageName() + ".fileprovider" (MainActivity, строка ~472).
             Раньше здесь было жёстко "com.planner.app.fileprovider", и при смене
             applicationId шаринг падал бы с IllegalArgumentException. Плейсхолдер
             ${applicationId} Gradle подставляет сам — теперь расхождение невозможно. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- НЕТ Firebase-сервиса и НЕТ FCM meta-data — уведомления локальные,
             через собственный foreground service (NotificationService). -->
    </application>
</manifest>
